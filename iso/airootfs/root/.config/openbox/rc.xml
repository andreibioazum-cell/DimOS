<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal openbox configuration for DimOS: no decorations, no key
     bindings, no desktop menu -- only enough EWMH support for the app to be
     fullscreen and focused. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
    <titleLayout></titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <chainQuitKey></chainQuitKey>
  </keyboard>
  <applications>
    <application class="*">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
